# Copy this file to .env for local dev (bun dev / npm run dev).
# In production (Cloudflare), set these as encrypted environment variables /
# secrets on the Worker/Pages project — never commit real values.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase "service_role" / secret key (starts with sb_secret_...).
# Server-only. Bypasses Row Level Security. NEVER expose to the browser,
# never prefix with VITE_, never reference from client components.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase "anon" / publishable key (starts with sb_publishable_...).
# Safe to expose to the browser — used for public, read-only queries.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Admin panel login (/admin). Pick your own values — see the security note
# in the project README before going live with these.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random string, 32+ characters, used to encrypt the admin session cookie.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Already used by the existing contact form — unchanged.
WEB3FORMS_ACCESS_KEY=
